<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>New Product - Tortilla.Co</title>
</head>
    <link rel="stylesheet" href="/css/style.css">
<body>
    <h1>Create a New Product</h1>
    <form method="POST" action="/product/new">
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" required>

        <label for="price">Price:</label>
        <input type="number" step="0.01" min="0" id="price" name="price" required>

        <label for="quantity">Initial stock quantity:</label>
        <input type="number" min="0" id="quantity" name="quantity" required>

        <button type="submit">Submit New Product</button>
    </form>
</body>

</html>