<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders - Tortilla Co.</title>
</head>
    <link rel="stylesheet" href="/css/style.css">
<body>
    <h1>Orders Dashboard</h1>
    <div class="nav-links">
        <a href="/orders/new">Create New Order</a>
        <a href="/customer/new">Create a New Client</a>
        <a href="/product/new">Create New Product</a>
    </div>
    

    <table>
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Status</th>
                <th>Action</th>
                <th>Invoice</th>
            </tr>
        </thead>
        <tbody>
            <% orders.forEach(function(order) { %>
                <tr>
                    <td><%= order.id %></td>
                    <td><%= order.customer.name %></td>
                    <td><%= order.date.toLocaleDateString() %></td>
                    <td><%= order.status %></td>
                    <td>
                        <% if (order.status === 'pending') { %> 
                            <form method="POST" action="/orders/<%= order.id %>/complete" class="inline-form">
                                <button type="submit">Complete</button>
                            </form>
                    <% } %>
                    </td>
                    <td><a href="/orders/<%= order.id %>/invoice">View Invoice</a></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</body>
</html>